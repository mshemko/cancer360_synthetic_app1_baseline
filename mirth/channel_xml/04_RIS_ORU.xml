<?xml version="1.0" encoding="UTF-8"?>
<mirth-channel-skeleton name="RIS_ORU" version="1.0">
  <summary>Receives RIS or CRIS ORU reports and writes radiology results.</summary>
  <channel-group>cancer360-hl7</channel-group>
  <source-connector type="llp-listener">
    <port>2575</port>
    <data-type>HL7V2</data-type>
    <ack-mode>auto</ack-mode>
    <filters>
      <sending-application>CRIS</sending-application>
      <sending-application>RIS</sending-application>
      <message-type>ORU^R01</message-type>
    </filters>
  </source-connector>
  <transformer>
    <script-file>mirth/channels/transformers/RIS_ORU.js</script-file>
    <required-code-template>UuidHelpers</required-code-template>
    <required-code-template>DateHelpers</required-code-template>
    <required-code-template>DbHelpers</required-code-template>
    <required-code-template>SourceRouting</required-code-template>
  </transformer>
  <destinations>
    <destination order="1" type="javascript-transformer">Extract accession, report text, conclusion, and patient context.</destination>
    <destination order="2" type="database-writer" sql-key="sql.radiology_result.upsert">Upsert radiology result row.</destination>
    <destination order="3" type="database-writer">Write integration audit row.</destination>
    <destination order="4" type="database-writer">Write dead-letter row on exception.</destination>
  </destinations>
</mirth-channel-skeleton>
